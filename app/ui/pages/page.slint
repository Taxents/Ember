// The page list: the collection header, track rows, shelves of cards, the grid and placeholders.

import { RadioSearch } from "../radio.slint";
import { Theme, Icon, IconButton, PillButton, Art, ScrollBar, ExplicitBadge, MiniVisualizer } from "../widgets.slint";
import { PageKind, RowKind, LyricLine, Card, TrackRow, Ui } from "../types.slint";

// ---- pages --------------------------------------------------------------------------------

// The banner: blurred cover and ribbing, the crisp cover on the right and the title block on it.
export component CollectionHeader inherits Rectangle {
    in property <length> banner-h;
    property <bool> wide: Ui.collection.wide;
    property <length> cover-size: root.wide ? 0px : min(root.banner-h * 0.68, 300px);
    property <length> cover-w: root.cover-size;

    Rectangle {
        y: 0;
        height: root.banner-h;
        clip: true;
        // Stretched, not cropped, so the whole band shows.
        Image {
            width: parent.width;
            height: parent.height;
            source: Ui.collection.banner;
            image-fit: root.wide ? ImageFit.cover : ImageFit.fill;
            // Fades in as it arrives (one already here shows at once).
            opacity: self.source.width > 0 ? 1 : 0;
            animate opacity { duration: 220ms; easing: ease-out; }
            // When the banner is wider than the picture, its top goes, never the bottom.
            vertical-alignment: ImageVerticalAlignment.bottom;
        }

        // Vertical-blind ribbing over the banner.
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../ribbing.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
        }

        if !root.wide: Rectangle {
            x: parent.width - root.cover-w - 56px;
            y: (root.banner-h - root.cover-size) / 2 + 8px;
            width: root.cover-w;
            height: root.cover-size;
            border-radius: 8px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000A0;
            background: Theme.smoke;
            Art {
                width: parent.width;
                height: parent.height;
                radius: 8px;
                source: Ui.collection.cover;
            }
        }
    }

    // The title block sits on the banner, bottom-left, clear of the cover.
    VerticalLayout {
        x: 34px;
        y: 0;
        width: parent.width - (root.wide ? 68px : root.cover-w + 56px + 34px + 32px);
        height: root.banner-h - 22px;
        spacing: 2px;
        alignment: end;
        if Ui.collection.label != "": Text {
            text: Ui.collection.label;
            color: Theme.beige;
            font-size: 12px;
            font-weight: 600;
        }

        if Ui.collection.logo.width > 0 || Ui.collection.logo-pending: Image {
            height: 120px;
            source: Ui.collection.logo;
            image-fit: contain;
            horizontal-alignment: ImageHorizontalAlignment.left;
            vertical-alignment: ImageVerticalAlignment.bottom;
        }

        if Ui.collection.logo.width == 0 && !Ui.collection.logo-pending && !Ui.renaming: title := Text {
            text: Ui.collection.title;
            color: Theme.ivory;
            font-size: 44px;
            font-weight: 800;
            overflow: elide;
            // Your own playlist: click the name to rename it.
            TouchArea {
                x: 0;
                width: min(title.width, title.preferred-width);
                enabled: Ui.collection.editable;
                mouse-cursor: text;
                clicked => {
                    Ui.renaming = true;
                }
            }
        }

        if Ui.renaming && Ui.collection.editable: FocusScope {
            height: name-input.preferred-height + 8px;
            key-pressed(e) => {
                if e.text == Key.Escape {
                    Ui.renaming = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                border-radius: 8px;
                background: #F1E5D214;
                border-width: 1px;
                border-color: Theme.amber.with-alpha(0.6);
            }
            name-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                text: Ui.collection.title;
                color: Theme.ivory;
                selection-background-color: Theme.amber.with-alpha(0.45);
                font-size: 44px;
                font-weight: 800;
                single-line: true;
                vertical-alignment: center;
                init => {
                    self.focus();
                    self.select-all();
                }
                changed has-focus => {
                    if !self.has-focus {
                        Ui.renaming = false;
                    }
                }
                accepted => {
                    if self.text != "" && self.text != Ui.collection.title {
                        Ui.rename(self.text);
                    }
                    Ui.renaming = false;
                }
            }
        }

        if Ui.collection.artist != "": banner-artist := Text {
            text: Ui.collection.artist;
            color: banner-artist-ta.has-hover ? Theme.amber.brighter(0.15) : Theme.amber;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
            banner-artist-ta := TouchArea {
                x: 0;
                width: min(banner-artist.width, banner-artist.preferred-width);
                enabled: Ui.collection.linked;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    Ui.open-artist(-1, { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
                }
            }
        }

        HorizontalLayout {
            padding-top: 16px;
            spacing: 10px;
            alignment: start;
            PillButton {
                text: "Play";
                icon: "play";
                clicked => {
                    Ui.play-tracks(-2);
                }
            }

            PillButton {
                text: "Shuffle";
                icon: "shuffle";
                primary: false;
                clicked => {
                    Ui.play-tracks(-1);
                }
            }

            if Ui.collection.can-save: PillButton {
                text: Ui.collection.saved ? "In library" : "Add to library";
                icon: Ui.collection.saved ? "check" : "plus";
                primary: false;
                clicked => {
                    Ui.toggle-saved();
                }
            }

            if Ui.collection.can-follow: PillButton {
                text: Ui.collection.following ? "Following" : "Follow";
                icon: Ui.collection.following ? "check" : "plus";
                primary: false;
                clicked => {
                    Ui.toggle-follow();
                }
            }
        }
    }
}

// One line of lyrics. The sung line is at full strength and fills with the accent word by word
// (Rust recolours its `fill`), over a faint accent glow. Lines already sung and still to come
// are ivory at reduced opacity, so the room's colour shows through. Background vocals are
// smaller, a duet's second voice sits on the right, and synced lines seek there when clicked.
export component LyricRow inherits Rectangle {
    in property <LyricLine> line;
    // The main line being sung, -1 when not following along.
    in property <int> active: -1;
    in property <bool> seekable;
    in property <length> font-size: 20px;
    // Its row, and whether it follows the song as it plays (the waiting dots need both).
    in property <int> index: -1;
    in property <bool> live: true;
    out property <bool> waiting: root.live && Ui.lyric-pause-row >= 0 && root.index == Ui.lyric-pause-row;
    out property <bool> sung: root.active >= 0 && root.line.group == root.active && Ui.lyric-pause-row < 0;
    property <length> pad: root.line.background ? 1px : 5px;
    property <length> dots-h: root.waiting ? 34px : 0px;
    property <length> size: root.line.background ? root.font-size * 0.72 : root.font-size;
    // How many lines away from the one being sung: further lines fade further.
    property <int> away: root.active < 0 ? 0 : abs(root.line.group - root.active);
    height: root.line.text == "" ? 12px : txt.preferred-height + 2 * root.pad + root.dots-h;
    animate dots-h { duration: 300ms; easing: ease-out; }

    // An instrumental break: three dots filling up until the next line comes in.
    if root.waiting: HorizontalLayout {
        x: root.line.agent == 1 ? parent.width - 64px : 4px;
        y: 4px;
        width: 60px;
        height: 22px;
        spacing: 9px;
        for k in 3: Rectangle {
            width: 11px;
            height: 11px;
            y: (22px - self.height) / 2;
            // Shrinking away just before the line comes in, eased; apart from the breathing
            // inside, which mustn't restart this animation on every step.
            transform-scale: Ui.lyric-pause > 0.94 ? 0.6 : 1;
            animate transform-scale { duration: 220ms; }
            Rectangle {
                border-radius: self.width / 2;
                background: Theme.ivory;
                opacity: 0.28 + 0.72 * clamp(Ui.lyric-pause * 3 - k, 0, 1);
                transform-scale: root.breathe;
            }
        }
    }
    // The dots breathe on the break's own clock (Rust moves `lyric-pause` with the music), not
    // `animation-tick()`, which would redraw the whole window every frame for as long as they show.
    property <float> breathe: 1 + 0.12 * sin(Ui.lyric-pause * root.line.gap * 0.25deg);

    // The sung line's words glow faintly, a touch more with the bass.
    property <float> bass: root.sung && !root.line.background ? Ui.levels[0] : 0;
    // Room around the text for the glow.
    property <length> room: 10px;
    lit := Rectangle {
        x: -root.room;
        y: root.dots-h - root.room;
        width: parent.width + 2 * root.room;
        height: txt.preferred-height + 2 * root.pad + 2 * root.room;

        if root.sung: Rectangle {
            for k in 8: StyledText {
                x: root.room + 1.6px * cos(k * 45deg);
                y: root.room + root.pad + 1.6px * sin(k * 45deg);
                width: root.width;
                text: root.line.glow;
                default-font-size: root.size;
                horizontal-alignment: root.line.agent == 1 ? right : left;
                opacity: 0.035 + 0.035 * root.bass;
            }
        }

        txt := StyledText {
            x: root.room;
            y: root.room + root.pad;
            width: root.width;
            text: root.line.fill;
            default-color: Theme.ivory;
            default-font-size: root.size;
            horizontal-alignment: root.line.agent == 1 ? right : left;
            // Not animated itself: `dim` eases, and a just-sung line comes in under its lit copy.
            // `lit` is read even while sung (max, not ?:): Slint only animates a property it
            // reads, so otherwise it'd still be 0 when the line ends and nothing would fade.
            opacity: root.dim * max(root.sung ? 1 : 0, 1 - root.lit) + (touch.has-hover && !root.sung ? 0.2 : 0);
        }

        // Just sung: the lit line fades away over the plain one, straight to grey.
        if !root.sung && root.lit > 0.01: StyledText {
            x: root.room;
            y: root.room + root.pad;
            width: root.width;
            text: root.line.done;
            default-font-size: root.size;
            horizontal-alignment: root.line.agent == 1 ? right : left;
            opacity: root.lit * (root.line.background ? 0.8 : 1);
        }
    }
    // How bright the line is for where it is: sung, coming up or gone, further ones dimmer.
    property <float> dim: (root.sung ? 1
        : root.active < 0 ? 0.85
        : root.line.group < root.active ? max(0.2, 0.38 - (root.away - 1) * 0.05)
        : max(0.28, 0.62 - (root.away - 1) * 0.08))
        * (root.line.background ? 0.8 : 1);
    animate dim { duration: 300ms; }
    property <float> lit: root.sung ? 1 : 0;
    animate lit { duration: 900ms; easing: ease-in-out; }

    touch := TouchArea {
        enabled: root.seekable && root.line.ms >= 0;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            Ui.seek(root.line.ms);
        }
    }
}

// A song page's details: lyrics on the left (following along while it plays), and its release
// date, credits and the artist's bio on the right.
export component SongDetails inherits Rectangle {
    in property <TrackRow> data;
    HorizontalLayout {
        padding-left: 34px;
        padding-right: 34px;
        padding-top: 28px;
        padding-bottom: 8px;
        spacing: 56px;
        if root.data.lines.length > 0: VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 8px;
            Text {
                text: "Lyrics";
                color: Theme.ivory;
                font-size: 20px;
                font-weight: 750;
            }

            Rectangle {
                height: 6px;
            }

            // While the song plays, the panel's lines: the same lyrics, filling as they're sung.
            for l[i] in root.data.live && Ui.lyrics.length > 0 ? Ui.lyrics : root.data.lines: LyricRow {
                line: l;
                index: i;
                live: root.data.live;
                active: root.data.live ? Ui.lyric-line : -1;
                seekable: root.data.live;
                font-size: 22px;
            }
            if root.data.note != "": Text {
                text: root.data.note;
                color: Theme.dim;
                font-size: 11px;
            }
        }
        VerticalLayout {
            width: root.data.lines.length > 0 ? min(320px, root.width * 0.34) : root.width - 68px;
            alignment: start;
            spacing: 18px;
            for c in root.data.info: VerticalLayout {
                spacing: 3px;
                Text {
                    text: c.label;
                    color: Theme.beige;
                    font-size: 11px;
                    font-weight: 600;
                }

                Text {
                    text: c.text;
                    color: Theme.ivory;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
            if root.data.about != "": VerticalLayout {
                spacing: 6px;
                Text {
                    text: "About the artist";
                    color: Theme.beige;
                    font-size: 11px;
                    font-weight: 600;
                }

                Text {
                    text: root.data.about;
                    color: Theme.ivory;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// One small label over a track list column.
export component ColumnTitle inherits Text {
    color: Theme.beige;
    opacity: 0.7;
    font-size: 10px;
    vertical-alignment: bottom;
}

// The titles over a track list's columns, laid out exactly as CollectionRow lays out a row.
export component ColumnTitles inherits Rectangle {
    property <bool> album: Ui.collection.album;
    property <length> fixed: 12px + 16px + 30px + (root.album ? 0px : 44px + 14px) + 84px + 44px + 4 * 14px;
    property <length> flex: max(0px, root.width - root.fixed);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 14px;
        ColumnTitle {
            width: 30px;
            text: "#";
            horizontal-alignment: right;
        }

        if !root.album: Rectangle {
            width: 44px;
        }

        ColumnTitle {
            width: root.album ? root.flex : root.flex * 0.6;
            text: "Title";
        }

        ColumnTitle {
            width: root.album ? 0px : root.flex * 0.4;
            text: root.album ? "" : "Album";
        }

        ColumnTitle {
            width: 84px;
            text: "Plays";
            horizontal-alignment: right;
        }

        ColumnTitle {
            width: 44px;
            text: "Time";
            horizontal-alignment: right;
        }
    }
}

// A track on its own dark strip. Albums leave out the artwork and the album column. On your own
// playlists, dragging a row moves it.
export component CollectionRow inherits Rectangle {
    in property <TrackRow> track;
    // Its row in the list (the header is row 0).
    in property <int> index;
    in-out property <int> drop-target;
    callback activated();
    callback open-album();
    property <bool> album: Ui.collection.album;
    // The play button and the album link have their own touch areas; the row counts as hovered
    // over them too, so nothing flickers as the mouse crosses them.
    property <bool> hovered: ta.has-hover || play-ta.has-hover || album-ta.has-hover;
    property <bool> dragging: Ui.collection.editable && ta.pressed && abs(ta.mouse-y - ta.pressed-y) > 4px;
    // Title and album share what the fixed columns leave, 3:2 (title alone on albums).
    property <length> fixed: 12px + 16px + 30px + (root.album ? 0px : 44px + 14px) + 84px + 44px + 4 * 14px;
    property <length> flex: max(0px, root.width - root.fixed);
    opacity: root.dragging ? 0.5 : root.track.unavailable ? 0.45 : 1;

    Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: root.hovered ? Theme.hover : transparent;
    }

    // Drop indicator above this row.
    if root.drop-target == root.index: Rectangle {
        y: -1px;
        height: 2px;
        background: Theme.amber;
    }

    accessible-role: list-item;
    accessible-label: root.track.title + ", " + root.track.artist + (root.track.duration != "" ? ", " + root.track.duration : "");
    accessible-item-selected: root.track.current;
    accessible-action-default => {
        root.activated();
    }
    row-focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) {
                root.activated();
                return accept;
            }
            if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                Ui.context("track", root.index, "", { x: self.absolute-position.x + 40px, y: self.absolute-position.y + root.height });
                return accept;
            }
            reject
        }
    }

    if row-focus.has-focus: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.amber;
    }

    ta := TouchArea {
        double-clicked => {
            root.activated();
        }
        moved => {
            if (root.dragging) {
                // Rows below move it after them, rows above before them.
                root.drop-target = max(1, min(Ui.page-count, root.index + round((self.mouse-y - self.pressed-y) / root.height) + (self.mouse-y > self.pressed-y ? 1 : 0)));
            }
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                Ui.context("track", root.index, "", { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
            } else if (e.kind == PointerEventKind.up) {
                if (root.drop-target >= 0 && root.drop-target != root.index && root.drop-target != root.index + 1) {
                    Ui.track-move(root.index, root.drop-target);
                }
                root.drop-target = -1;
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 14px;
        Rectangle {
            width: 30px;
            // The number; the playing song shows bars instead, like Apple Music.
            if !root.hovered && !root.track.current: Text {
                width: 100%;
                text: root.track.number;
                color: Theme.beige;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            if !root.hovered && root.track.current: MiniVisualizer {
                x: parent.width - self.width;
                playing: Ui.np.playing;
                levels: Ui.levels;
            }

            // Hovered: play, or pause/resume on the playing song.
            Icon {
                x: parent.width - 14px;
                visible: root.hovered;
                name: root.track.current && Ui.np.playing ? "pause" : "play";
                width: 14px;
                height: 14px;
                color: Theme.ivory;
            }

            play-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.track.current {
                        Ui.play-pause();
                    } else {
                        root.activated();
                    }
                }
            }
        }

        if !root.album: Rectangle {
            width: 44px;
            Art {
                width: 44px;
                height: 44px;
                source: root.track.art;
            }
        }

        VerticalLayout {
            alignment: center;
            width: root.album ? root.flex : root.flex * 0.6;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.track.title;
                    color: Theme.ivory;
                    font-size: 14px;
                    font-weight: 550;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }

                if root.track.explicit: ExplicitBadge { }
            }

            if root.track.artist != "": row-artist := Text {
                text: root.track.artist;
                color: artist-ta.has-hover ? Theme.ivory : Theme.beige;
                font-size: 12px;
                overflow: elide;
                artist-ta := TouchArea {
                    x: 0;
                    width: min(row-artist.width, row-artist.preferred-width);
                    enabled: root.track.artist != "";
                    mouse-cursor: pointer;
                    clicked => {
                        Ui.open-artist(root.index, { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
                    }
                }
            }
        }

        // Empty and zero-width on albums.
        Rectangle {
            width: root.album ? 0px : root.flex * 0.4;
            album-ta := TouchArea {
                x: 0;
                width: min(parent.width, album-text.preferred-width);
                enabled: !root.album && root.track.album != "";
                mouse-cursor: pointer;
                clicked => {
                    root.open-album();
                }
            }

            album-text := Text {
                x: 0;
                width: parent.width;
                text: root.album ? "" : root.track.album;
                color: album-ta.has-hover ? Theme.ivory : Theme.beige;
                font-size: 12px;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            width: 84px;
            text: root.track.plays;
            color: Theme.beige;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            width: 44px;
            text: root.track.duration;
            color: Theme.beige;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A card: artwork (round for artists) with its title and subtitle under it, or a coloured tile.
// A play button shows over the artwork on hover.
export component CardView inherits Rectangle {
    in property <Card> card;
    in property <int> line;
    in property <int> index;
    // A video's card is 16:9 wide, so its art comes out as tall as a square card's.
    property <length> art-h: root.card.tile ? root.width * 0.56 : root.card.video ? root.width * 9 / 16 : root.width;
    property <bool> hovered: ta.has-hover || play-ta.has-hover;
    height: root.card.tile ? root.art-h : root.art-h + 46px;
    init => {
        Ui.card-shown(root.line, root.index);
    }
    // Rows are reused as the list scrolls.
    changed line => {
        Ui.card-shown(root.line, root.index);
    }

    accessible-role: list-item;
    accessible-label: root.card.title + (root.card.subtitle != "" ? ", " + root.card.subtitle : "");
    accessible-action-default => {
        Ui.card-clicked(root.line, root.index);
    }
    card-focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) {
                Ui.card-clicked(root.line, root.index);
                return accept;
            }
            if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                Ui.context("card", root.line, root.index, { x: self.absolute-position.x + 20px, y: self.absolute-position.y + 20px });
                return accept;
            }
            reject
        }
    }

    if card-focus.has-focus: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.amber;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Ui.card-clicked(root.line, root.index);
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                Ui.context("card", root.line, root.index, { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
            }
        }
    }

    Rectangle {
        y: 0;
        width: root.width;
        height: root.art-h;
        border-radius: root.card.round ? root.width / 2 : 8px;
        background: root.card.tile ? root.card.color : Theme.smoke;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 5px;
        drop-shadow-color: #00000070;
        clip: true;
        if !root.card.tile: Image {
            width: parent.width;
            height: parent.height;
            source: root.card.art;
            image-fit: cover;
            // Fades in as it arrives (one already here shows at once).
            opacity: self.source.width > 0 ? 1 : 0;
            animate opacity { duration: 220ms; easing: ease-out; }
        }
        if root.card.tile: Rectangle {
            background: @linear-gradient(160deg, #FFFFFF1A 0%, #00000059 100%);
        }
        if root.card.tile: Text {
            x: 14px;
            y: parent.height - self.height - 12px;
            width: parent.width - 28px;
            text: root.card.title;
            color: Theme.ivory;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
        }
        Rectangle {
            background: root.hovered ? #00000038 : transparent;
            animate background { duration: 120ms; }
        }
    }

    Rectangle {
        x: root.card.round ? (root.width - self.width) / 2 : 10px;
        y: root.art-h - self.height - 10px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        visible: root.card.playable && root.hovered;
        background: play-ta.has-hover ? Theme.amber : #120D0BD9;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000080;
        Icon {
            x: 12px;
            y: 11px;
            width: 14px;
            height: 14px;
            name: "play";
            color: play-ta.has-hover ? Theme.carbon : Theme.ivory;
        }

        play-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Ui.card-play(root.line, root.index);
            }
        }
    }

    if !root.card.tile: VerticalLayout {
        y: root.art-h + 8px;
        height: 38px;
        spacing: 1px;
        alignment: start;
        Text {
            text: root.card.title;
            color: Theme.ivory;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: root.card.round ? center : left;
        }

        Text {
            text: root.card.subtitle;
            color: Theme.beige;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: root.card.round ? center : left;
        }
    }
}

export component SeeAll inherits Text {
    callback clicked();
    text: "See all";
    color: see-ta.has-hover ? Theme.ivory : Theme.amber;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
    see-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A titled row of cards that scrolls sideways, with arrows for mice that can't.
export component ShelfRow inherits Rectangle {
    in property <TrackRow> shelf;
    in property <int> index;
    in property <length> card-w;
    property <length> gap: 20px;
    property <length> top: root.shelf.title != "" ? 52px : 8px;

    if root.shelf.title != "": Text {
        x: 34px;
        y: 16px;
        width: parent.width - 220px;
        text: root.shelf.title;
        color: Theme.ivory;
        font-size: 20px;
        font-weight: 750;
        overflow: elide;
    }

    if root.shelf.title != "": HorizontalLayout {
        x: 0;
        y: 12px;
        width: parent.width - 30px;
        height: 32px;
        spacing: 4px;
        alignment: end;
        if root.shelf.link: SeeAll {
            clicked => {
                Ui.see-all(root.index);
            }
        }
        Rectangle {
            width: 10px;
        }

        if flick.content-width > flick.width: Rectangle {
            width: 32px;
            IconButton {
                icon: "back";
                tooltip: "Scroll left";
                enabled: flick.content-x < -1px;
                clicked => {
                    flick.content-x = min(0px, flick.content-x + flick.width * 0.8);
                }
            }
        }

        if flick.content-width > flick.width: Rectangle {
            width: 32px;
            IconButton {
                icon: "forward";
                tooltip: "Scroll right";
                enabled: flick.content-x > flick.width - flick.content-width + 1px;
                clicked => {
                    flick.content-x = max(flick.width - flick.content-width, flick.content-x - flick.width * 0.8);
                }
            }
        }
    }

    flick := Flickable {
        y: root.top;
        height: parent.height - root.top;
        property <int> n: root.shelf.cards.length;
        property <float> units: self.n == 0 ? 0 : root.shelf.cards[self.n - 1].at + (root.shelf.cards[self.n - 1].video ? 16 / 9 : 1);
        content-width: 68px + self.units * root.card-w + max(0, self.n - 1) * root.gap;
        for c[j] in root.shelf.cards: CardView {
            x: 34px + c.at * root.card-w + j * root.gap;
            y: 0;
            width: root.card-w * (c.video ? 16 / 9 : 1);
            card: c;
            line: root.index;
            index: j;
        }
    }
}

// A placeholder block of the loading skeleton: it breathes, a little later the lower it sits.
export component Bone inherits Rectangle {
    in property <float> delay;
    border-radius: 6px;
    background: Theme.smoke;
    opacity: 0.45 + 0.35 * (1 + sin(animation-tick() / 1300ms * 360deg - root.delay * 360deg)) / 2;
}

// A placeholder row while the page loads, laid out like the row it stands in for.
export component SkeletonRow inherits Rectangle {
    in property <int> style;
    in property <int> index;
    in property <length> grid-card;
    in property <length> shelf-card;
    in property <int> columns;
    property <bool> round: Ui.page.kind == PageKind.artists;
    // Album tracks go without art, artist or album.
    property <bool> album: Ui.collection.album;
    property <float> delay: 0.06 * mod(root.index, 16);
    clip: true;

    if root.style == 0: Rectangle {
        x: 24px;
        width: parent.width - 48px;
        // As CollectionRow: number, art, title over artist, album, length.
        Bone {
            x: 12px + 16px - 6px;
            y: 26px;
            width: 12px;
            height: 12px;
            delay: root.delay;
        }
        if !root.album: Bone {
            x: 12px + 16px + 30px;
            y: 10px;
            width: 44px;
            height: 44px;
            delay: root.delay;
        }
        Bone {
            x: 12px + 16px + 30px + (root.album ? 0px : 58px);
            y: root.album ? 26px : 16px;
            width: min(260px, parent.width * 0.3) - mod(root.index * 37, 90) * 1px;
            height: 13px;
            delay: root.delay;
        }
        if !root.album: Bone {
            x: 12px + 16px + 30px + 58px;
            y: 37px;
            width: min(160px, parent.width * 0.18) - mod(root.index * 23, 50) * 1px;
            height: 11px;
            delay: root.delay;
        }
        if !root.album: Bone {
            x: parent.width * 0.58;
            y: 26px;
            width: min(180px, parent.width * 0.2) - mod(root.index * 29, 60) * 1px;
            height: 12px;
            delay: root.delay;
        }
        Bone {
            x: parent.width - 60px;
            y: 26px;
            width: 36px;
            height: 12px;
            delay: root.delay;
        }
    }

    // A shelf: its heading and a row of cards.
    if root.style == 1: Rectangle {
        Bone {
            x: 34px;
            y: 18px;
            width: 220px - mod(root.index * 41, 80) * 1px;
            height: 20px;
            delay: root.delay;
        }
        for c in ceil((parent.width - 34px) / (root.shelf-card + 20px)): Rectangle {
            x: 34px + c * (root.shelf-card + 20px);
            y: 52px;
            width: root.shelf-card;
            height: root.shelf-card + 46px;
            property <float> delay: root.delay + 0.04 * c;
            Bone {
                y: 0;
                height: parent.width;
                border-radius: 8px;
                delay: parent.delay;
            }
            Bone {
                y: parent.width + 12px;
                width: parent.width * 0.8 - mod(c * 31, 40) * 1px;
                height: 13px;
                delay: parent.delay;
            }
            Bone {
                y: parent.width + 32px;
                width: parent.width * 0.5 - mod(c * 17, 30) * 1px;
                height: 11px;
                delay: parent.delay;
            }
        }
    }

    // A grid line: as many cards as the grid holds.
    if root.style == 2: Rectangle {
        for c in root.columns: Rectangle {
            x: 34px + c * (root.grid-card + 20px);
            y: 0;
            width: root.grid-card;
            height: root.grid-card + 46px;
            property <float> delay: root.delay + 0.03 * c;
            Bone {
                y: 0;
                height: parent.width;
                border-radius: root.round ? parent.width / 2 : 8px;
                delay: parent.delay;
            }
            Bone {
                x: root.round ? parent.width * 0.2 : 0;
                y: parent.width + 12px;
                width: parent.width * (root.round ? 0.6 : 0.75);
                height: 13px;
                delay: parent.delay;
            }
            Bone {
                x: root.round ? parent.width * 0.3 : 0;
                y: parent.width + 32px;
                width: parent.width * (root.round ? 0.4 : 0.5);
                height: 11px;
                delay: parent.delay;
            }
        }
    }
}

// Every page: one list of rows (a banner or title, headings, tracks, card shelves and grids)
// that scrolls as one, the banner with it.
export component PageView inherits Rectangle {
    // Home's hero is a title and two buttons, so it stays shorter than an album's banner.
    property <length> banner-h: Ui.page.kind == PageKind.home ? clamp(root.height * 0.36, 260px, 360px) : clamp(root.height * 0.46, 300px, 500px);
    property <int> drop-target: -1;
    property <length> shelf-card: 176px;
    // Grid lines hold as many cards of at least 170px as fit.
    property <int> columns: max(2, floor((root.width - 68px + 20px) / (170px + 20px)));
    property <length> grid-card: (root.width - 68px - (root.columns - 1) * 20px) / root.columns;
    // Rust lays the rows out from these (see rows.rs), so it must hear when they change.
    property <length> view-h: root.height;
    property <length> view-w: root.width;
    // A playing music video's panel under the song page's banner: the content's width at 16:9,
    // at most three quarters of the view tall (then narrower, centred). rows.rs adds the same
    // height (plus 24px below) to the header row.
    property <length> video-h: min((root.view-w - 68px) * 9 / 16, root.view-h * 0.75);
    property <int> serial: Ui.page-serial;
    init => {
        Ui.columns-changed(root.columns);
        Ui.page-metrics(root.banner-h, root.grid-card, root.view-h, root.view-w);
    }
    changed columns => {
        Ui.columns-changed(root.columns);
    }
    changed banner-h => {
        Ui.page-metrics(root.banner-h, root.grid-card, root.view-h, root.view-w);
    }
    changed grid-card => {
        Ui.page-metrics(root.banner-h, root.grid-card, root.view-h, root.view-w);
    }
    changed view-h => {
        Ui.page-metrics(root.banner-h, root.grid-card, root.view-h, root.view-w);
    }
    changed view-w => {
        Ui.page-metrics(root.banner-h, root.grid-card, root.view-h, root.view-w);
    }
    // A new page starts at the top, or where Back/Forward left it.
    changed serial => {
        root.scroll-back();
    }
    property <int> scroll-serial: Ui.scroll-serial;
    changed scroll-serial => {
        root.scroll-back();
    }
    function scroll-back() {
        list.content-y = -min(Ui.page-scroll * 1px, max(0px, list.content-height - list.height));
    }
    // An opened music video: once its panel shows, glide down to centre it in the view, and
    // keep it there while the page fills in, until you scroll yourself or leave the page.
    property <int> centre-serial: Ui.centre-video-serial;
    property <bool> centring;
    property <int> centre-page;
    property <length> centre-set; // where gliding last put the list: anything else was you
    property <length> centre-target: min(0px, max(list.height - list.content-height,
        -(root.banner-h + 16px + root.video-h / 2 - list.height / 2)));
    changed centre-serial => {
        root.centring = true;
        root.centre-page = Ui.page-serial;
        list.content-y = 0;
        root.centre-set = 0;
    }
    Timer {
        interval: 16ms;
        running: root.centring && Ui.video-on && Ui.page-serial == root.centre-page
            && abs(list.content-y - root.centre-target) > 0.5px;
        triggered => {
            if abs(list.content-y - root.centre-set) > 1px {
                root.centring = false;
                return;
            }
            let d = root.centre-target - list.content-y;
            let step = abs(d) <= 1px ? d : (d > 0 ? max(1px, d * 0.18) : min(-1px, d * 0.18));
            list.content-y += step;
            root.centre-set = list.content-y;
        }
    }

    // The whole page's height is known, and only the rows near the view exist, each at its place.
    list := Flickable {
        content-height: Ui.page-height;
        changed content-y => {
            Ui.page-scrolled(-self.content-y);
        }
        flicked => {
            root.centring = false;
        }
        for row in Ui.tracks: Rectangle {
            property <int> i: row.index;
            y: row.y;
            height: row.h;
            width: list.width;
            init => {
                Ui.row-shown(0, row.index);
                if (row.index >= Ui.page-count - 20) {
                    Ui.near-end();
                }
            }
            if row.kind == RowKind.header: CollectionHeader {
                banner-h: root.banner-h;
            }
            // The music video's picture, letterboxed on black, under the banner.
            if row.kind == RowKind.header && Ui.video-on: Rectangle {
                width: root.video-h * 16 / 9;
                height: root.video-h;
                x: (parent.width - self.width) / 2;
                y: root.banner-h + 16px;
                border-radius: 8px;
                clip: true;
                background: #000000;
                drop-shadow-blur: 32px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #000000A0;
                if Ui.video-frame.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: Ui.video-frame;
                    image-fit: contain;
                }
                // A faint amber edge: the screen is lit.
                Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.amber.with-alpha(0.22);
                }
            }
            // Radio pages keep the right of the title for the station search.
            if row.kind == RowKind.title && Ui.page.kind == PageKind.radio: RadioSearch {
                x: parent.width - self.width - 34px;
                y: 60px;
                width: min(320px, parent.width * 0.42);
                accepted(q) => {
                    Ui.navigate(PageKind.radio, "search:" + q, q);
                }
            }
            if row.kind == RowKind.title: VerticalLayout {
                x: 34px;
                width: parent.width - 68px - (Ui.page.kind == PageKind.radio ? min(340px, parent.width * 0.42 + 20px) : 0px);
                padding-top: 56px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: Ui.page.title;
                    color: Theme.ivory;
                    font-size: 34px;
                    font-weight: 800;
                    overflow: elide;
                }

                // The Artists page: how far back its stats look.
                if row.link: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for p in [
                        { id: "4w", label: "4 weeks" },
                        { id: "6m", label: "6 months" },
                        { id: "1y", label: "Year" },
                        { id: "all", label: "All time" },
                    ]: PillButton {
                        text: p.label;
                        primary: Ui.page.id == p.id || (Ui.page.id == "" && p.id == "4w");
                        clicked => {
                            Ui.navigate(PageKind.artists, p.id, "Artists");
                        }
                    }
                }

                if Ui.page.playable: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    PillButton {
                        text: "Play";
                        icon: "play";
                        clicked => {
                            Ui.play-tracks(-2);
                        }
                    }

                    PillButton {
                        text: "Shuffle";
                        icon: "shuffle";
                        primary: false;
                        clicked => {
                            Ui.play-tracks(-1);
                        }
                    }
                }
            }
            if row.kind == RowKind.details: SongDetails {
                data: row;
                height: max(self.preferred-height, parent.height);
                init => {
                    Ui.row-measured(row.index, self.preferred-height);
                }
                changed preferred-height => {
                    Ui.row-measured(row.index, self.preferred-height);
                }
            }
            if row.kind == RowKind.columns: ColumnTitles {
                x: 24px;
                width: parent.width - 48px;
            }
            if row.kind == RowKind.heading: Rectangle {
                Text {
                    x: 34px;
                    y: parent.height - self.height - 12px;
                    width: parent.width - 160px;
                    text: row.title;
                    color: Theme.ivory;
                    font-size: 20px;
                    font-weight: 750;
                    overflow: elide;
                }

                if row.link: SeeAll {
                    x: parent.width - self.width - 34px;
                    y: parent.height - self.height - 14px;
                    clicked => {
                        Ui.see-all(i);
                    }
                }
            }
            if row.kind == RowKind.shelf: ShelfRow {
                shelf: row;
                index: i;
                card-w: root.shelf-card;
            }
            if row.kind == RowKind.grid: Rectangle {
                for c[j] in row.cards: CardView {
                    x: 34px + c.at * root.grid-card + j * 20px;
                    y: 0;
                    width: root.grid-card * (c.video ? 16 / 9 : 1);
                    card: c;
                    line: i;
                    index: j;
                }
            }
            if row.kind == RowKind.footer: Text {
                x: 46px;
                text: row.title;
                color: Theme.beige;
                font-size: 12px;
                vertical-alignment: center;
            }
            if row.kind == RowKind.skeleton: SkeletonRow {
                style: row.number;
                index: i;
                grid-card: root.grid-card;
                shelf-card: root.shelf-card;
                columns: root.columns;
            }
            if row.kind == RowKind.track: CollectionRow {
                x: 24px;
                width: parent.width - 48px;
                track: row;
                index: i;
                drop-target <=> root.drop-target;
                activated => {
                    Ui.play-tracks(i);
                }
                open-album => {
                    Ui.open-album(i);
                }
            }
        }
    }
    ScrollBar {
        x: list.x + list.width - self.width;
        y: list.y;
        height: list.height;
        content-y <=> list.content-y;
        content-height: list.content-height;
        visible-height: list.height;
    }
}
