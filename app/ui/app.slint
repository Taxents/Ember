// The main window: sidebar, content, the docked right panel and the now-playing bar.

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";
import { ListView, Palette } from "std-widgets.slint";
import { Theme, Icon, IconButton, PillButton, Art, ScrollBar, EmptyState } from "widgets.slint";
import { PageKind, RowKind, LyricLine, InfoLine, Card, SidebarPlaylist, TrackRow, MenuEntry, Collection, NowPlaying, PageState, Ui } from "types.slint";
import { NowPlayingBar } from "player.slint";
import { LyricRow, PageView } from "pages/page.slint";
import { SettingsPage } from "pages/settings.slint";
import { StatusPage } from "pages/status.slint";

export { Theme }
export { PageKind, RowKind, LyricLine, InfoLine, Card, SidebarPlaylist, TrackRow, MenuEntry, Collection, NowPlaying, PageState, Ui }

// ---- sidebar --------------------------------------------------------------------------------

component SideRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> collapsed;
    in property <bool> has-cover;
    in property <image> cover;
    callback clicked();
    // Right-clicked at this point (window coordinates).
    callback menu(Point);
    // Rows that can be dragged into another order: this one's place among `count`, and where a
    // drag would drop it (-1: none), shared by the rows.
    in property <bool> draggable;
    in property <int> index;
    in property <int> count;
    in-out property <int> drop-target: -1;
    callback dropped(int, int);
    property <length> step: 32px; // its height and the list's spacing
    property <bool> dragging: root.draggable && ta.pressed && abs(ta.mouse-y - ta.pressed-y) > 4px;
    // A drag ends with a release, which isn't a click.
    property <bool> dragged;
    height: 30px;
    border-radius: 6px;
    background: selected ? Theme.smoke : ta.has-hover ? Theme.smoke.with-alpha(0.45) : transparent;
    opacity: root.dragging ? 0.5 : 1;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    side-focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                root.menu({ x: self.absolute-position.x + 20px, y: self.absolute-position.y + root.height });
                return accept;
            }
            reject
        }
    }

    if side-focus.has-focus: Rectangle {
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.amber;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if !root.dragged {
                root.clicked();
            }
        }
        moved => {
            if root.dragging {
                root.dragged = true;
                // Rows below move it after them, rows above before them.
                root.drop-target = max(0, min(root.count, root.index + round((self.mouse-y - self.pressed-y) / root.step) + (self.mouse-y > self.pressed-y ? 1 : 0)));
            }
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu({ x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.dragged = false;
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                if root.dragged && root.drop-target >= 0 {
                    root.dropped(root.index, root.drop-target);
                }
                root.drop-target = -1;
            }
        }
    }

    // Where the dragged row would land: a line above this row (or below the last).
    if root.draggable && root.drop-target == root.index: Rectangle {
        y: -2px;
        height: 2px;
        background: Theme.amber;
    }
    if root.draggable && root.drop-target == root.count && root.index == root.count - 1: Rectangle {
        y: root.height;
        height: 2px;
        background: Theme.amber;
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 8px;
        spacing: 10px;
        if root.has-cover: Rectangle {
            width: 18px;
            Art {
                width: 18px;
                height: 18px;
                radius: 3px;
                source: root.cover;
            }
        }
        if !root.has-cover: Rectangle {
            width: 18px;
            Icon {
                name: root.icon;
                width: 17px;
                height: 17px;
                color: Theme.amber;
            }
        }
        if !root.collapsed: Text {
            text: root.label;
            color: Theme.ivory;
            font-size: 13px;
            font-weight: root.selected ? 600 : 450;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> text;
    in property <bool> collapsible;
    in-out property <bool> open: true;
    height: 26px;
    TouchArea {
        enabled: root.collapsible;
        mouse-cursor: root.collapsible ? pointer : default;
        clicked => {
            root.open = !root.open;
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-top: 8px;
        spacing: 4px;
        Text {
            text: root.text;
            color: Theme.beige;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.collapsible: Rectangle {
            width: 12px;
            Icon {
                name: root.open ? "chevron-down" : "chevron-right";
                width: 11px;
                height: 11px;
                color: Theme.beige;
            }
        }
        Rectangle { }
    }
}

component SearchField inherits Rectangle {
    in property <bool> collapsed;
    callback accepted(string);
    callback cancelled();
    out property <bool> has-focus: input.has-focus;
    public function focus-input() {
        input.focus();
    }
    height: 30px;
    border-radius: 8px;
    background: input.has-focus ? Theme.smoke : Theme.smoke.with-alpha(0.6);
    border-width: input.has-focus ? 1px : 0;
    border-color: Theme.amber.with-alpha(0.6);
    TouchArea {
        mouse-cursor: text;
        clicked => {
            input.focus();
        }
    }

    Rectangle {
        x: 9px;
        width: 15px;
        Icon {
            name: "search";
            width: 15px;
            height: 15px;
            color: Theme.beige;
        }
    }

    if !root.collapsed && input.text == "": Text {
        x: 32px;
        text: "Search";
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }
    // Esc leaves the field, back to the shortcuts.
    FocusScope {
        x: 32px;
        width: parent.width - 40px;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            reject
        }
        input := TextInput {
            visible: !root.collapsed;
            accessible-label: "Search";
            color: Theme.ivory;
            selection-background-color: Theme.oxide;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                if (self.text != "") {
                    root.accepted(self.text);
                }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <bool> collapsed;
    in-out property <bool> playlists-open: true;
    // A search was made: the keyboard goes back to the shortcuts.
    callback searched();
    // Where a dragged playlist would drop (-1: no drag).
    property <int> playlist-drop: -1;
    public function focus-search() {
        search.focus-input();
    }
    background: Theme.sidebar;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.smoke;
    }

    VerticalLayout {
        padding: 10px;
        padding-top: 12px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            search := SearchField {
                visible: !root.collapsed;
                max-width: root.collapsed ? 0px : 1000px;
                collapsed: root.collapsed;
                accepted(q) => {
                    Ui.search(q);
                    root.searched();
                }
                cancelled => {
                    root.searched();
                }
            }
            IconButton {
                icon: "sidebar";
                tooltip: Ui.sidebar-collapsed ? "Expand sidebar" : "Collapse sidebar";
                size: 30px;
                icon-size: 16px;
                clicked => {
                    Ui.sidebar-collapsed = !Ui.sidebar-collapsed;
                    Ui.sidebar-changed();
                }
            }
        }

        Rectangle {
            height: 8px;
        }

        SideRow {
            icon: "home";
            label: "Home";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.home;
            clicked => {
                Ui.navigate(PageKind.home, "", "Home");
            }
        }

        SideRow {
            icon: "explore";
            label: "Explore";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.explore;
            clicked => {
                Ui.navigate(PageKind.explore, "", "Explore");
            }
        }

        SideRow {
            icon: "radio";
            label: "Radio";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.radio;
            clicked => {
                Ui.navigate(PageKind.radio, "", "Radio");
            }
        }

        if !root.collapsed: SectionHeader {
            text: "Library";
        }
        if root.collapsed: Rectangle {
            height: 12px;
        }
        SideRow {
            icon: "history";
            label: "Recently played";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.history;
            clicked => {
                Ui.navigate(PageKind.history, "", "Recently played");
            }
        }

        SideRow {
            icon: "artist";
            label: "Artists";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.artists;
            clicked => {
                Ui.navigate(PageKind.artists, "", "Artists");
            }
        }

        SideRow {
            icon: "album";
            label: "Albums";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.albums;
            clicked => {
                Ui.navigate(PageKind.albums, "", "Albums");
            }
        }

        if !root.collapsed: SectionHeader {
            text: "Playlists";
            collapsible: true;
            open <=> root.playlists-open;
        }
        if root.collapsed: Rectangle {
            height: 12px;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                if root.playlists-open || root.collapsed: SideRow {
                    icon: "grid";
                    label: "All playlists";
                    collapsed: root.collapsed;
                    selected: Ui.page.kind == PageKind.all-playlists;
                    clicked => {
                        Ui.navigate(PageKind.all-playlists, "", "All playlists");
                    }
                }
                if root.playlists-open || root.collapsed: SideRow {
                    icon: "heart";
                    label: "Liked songs";
                    collapsed: root.collapsed;
                    selected: Ui.page.kind == PageKind.liked;
                    clicked => {
                        Ui.navigate(PageKind.liked, "LM", "Liked songs");
                    }
                }
                if (root.playlists-open || root.collapsed) && !(Ui.naming-playlist && !root.collapsed): SideRow {
                    icon: "plus";
                    label: "New playlist";
                    collapsed: root.collapsed;
                    clicked => {
                        Ui.new-playlist();
                    }
                }
                // Naming a new playlist, right where it'll appear: Enter makes it, Escape doesn't.
                if Ui.naming-playlist && !root.collapsed: FocusScope {
                    height: 30px;
                    function place() {
                        Ui.naming-field = { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
                    }
                    init => {
                        self.place();
                    }
                    changed width => {
                        self.place();
                    }
                    changed absolute-position => {
                        self.place();
                    }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            Ui.create-playlist("");
                            return accept;
                        }
                        reject
                    }
                    Rectangle {
                        border-radius: 6px;
                        background: #F1E5D214;
                        border-width: 1px;
                        border-color: Theme.amber.with-alpha(0.6);
                    }
                    if new-name.text == "": Text {
                        x: 10px;
                        height: parent.height;
                        text: "Playlist name";
                        color: Theme.beige.with-alpha(0.7);
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    new-name := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        color: Theme.ivory;
                        selection-background-color: Theme.amber.with-alpha(0.45);
                        font-size: 13px;
                        single-line: true;
                        vertical-alignment: center;
                        init => {
                            self.focus();
                        }
                        accepted => {
                            Ui.create-playlist(self.text);
                        }
                        changed has-focus => {
                            // Clicked away with nothing typed: never mind.
                            if !self.has-focus && self.text == "" {
                                Ui.create-playlist("");
                            }
                        }
                    }
                }
                if root.playlists-open && !root.collapsed: VerticalLayout {
                    spacing: 2px;
                    for p[i] in Ui.playlists: SideRow {
                        draggable: !root.collapsed;
                        index: i;
                        count: Ui.playlists.length;
                        drop-target <=> root.playlist-drop;
                        dropped(from, to) => {
                            Ui.move-playlist(from, to);
                        }
                        has-cover: true;
                        cover: p.cover;
                        label: p.title;
                        selected: Ui.page.kind == PageKind.playlist && Ui.page.id == p.id;
                        clicked => {
                            Ui.navigate(PageKind.playlist, p.id, p.title);
                        }
                        menu(at) => {
                            Ui.context("playlist", 0, p.id, at);
                        }
                    }
                }
            }
        }

        // A newer version: found (download on request), downloading, then ready to restart into.
        if Ui.update-ready != "" || (Ui.update-available != "" && !Ui.update-dismissed): banner := Rectangle {
            property <bool> ready: Ui.update-ready != "";
            property <bool> busy: Ui.update-progress != "";
            property <bool> failed: Ui.update-error != "";
            border-radius: 8px;
            background: Theme.amber.with-alpha(0.14);
            // Collapsed, it's just the icon: restart when ready, else Settings says the rest.
            if root.collapsed: Rectangle {
                height: 40px;
                background: upd.has-hover ? Theme.amber.with-alpha(0.08) : transparent;
                border-radius: 8px;
                upd := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (banner.ready) {
                            Ui.restart-to-update();
                        } else {
                            Ui.navigate(PageKind.settings, "", "Settings");
                        }
                    }
                }

                Icon {
                    name: banner.ready ? "check" : "download";
                    width: 16px;
                    height: 16px;
                    color: Theme.amber;
                }
            }
            // One line, the whole of it the button: from this version to the new one, its
            // download, or a restart into it.
            if !root.collapsed: card := Rectangle {
                height: 36px;
                property <bool> can-act: !banner.busy && !Ui.update-unverified;
                border-radius: 8px;
                background: act.has-hover && self.can-act ? Theme.amber.with-alpha(0.08) : transparent;
                function go() {
                    if (!self.can-act) {
                        return;
                    }
                    if (banner.ready) {
                        Ui.restart-to-update();
                    } else {
                        Ui.update-install();
                    }
                }
                accessible-role: button;
                accessible-label: label.text;
                accessible-action-default => {
                    self.go();
                }
                act := TouchArea {
                    mouse-cursor: card.can-act ? pointer : default;
                    clicked => {
                        card.go();
                    }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        name: banner.ready ? "check" : "download";
                        width: 16px;
                        height: 16px;
                        color: Theme.amber;
                    }

                    label := Text {
                        horizontal-stretch: 1;
                        text: banner.ready ? "Restart to apply"
                            : banner.failed ? Ui.update-error
                            : banner.busy ? Ui.update-progress
                            : Ui.app-version + " → " + Ui.update-available;
                        color: card.can-act ? Theme.amber : Theme.ivory;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if !banner.ready && !banner.busy: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "close";
                        size: 24px;
                        icon-size: 12px;
                        tooltip: "Not now";
                        clicked => {
                            Ui.update-dismiss();
                        }
                    }
                }
            }
        }

        SideRow {
            icon: "settings";
            label: "Settings";
            collapsed: root.collapsed;
            selected: Ui.page.kind == PageKind.settings;
            clicked => {
                Ui.navigate(PageKind.settings, "", "Settings");
            }
        }

        // Account
        Rectangle {
            height: 1px;
            background: Theme.smoke;
        }

        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: acct.has-hover ? Theme.hover : transparent;
            acct := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (Ui.signed-in) {
                        menu.show();
                    } else if (!Ui.signing-in) {
                        Ui.sign-in();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                spacing: 10px;
                Rectangle {
                    width: 28px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        clip: true;
                        background: Theme.smoke;
                        Icon {
                            name: "user";
                            width: 16px;
                            height: 16px;
                            color: Theme.beige;
                        }

                        Image {
                            width: 28px;
                            height: 28px;
                            source: Ui.account-photo;
                            image-fit: cover;
                        }
                    }
                }

                if !root.collapsed: Text {
                    text: Ui.signed-in ? Ui.account-name : Ui.signing-in ? "Signing in…" : "Sign in";
                    color: Ui.signed-in ? Theme.ivory : Theme.amber;
                    font-size: 13px;
                    font-weight: 550;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            menu := PopupWindow {
                x: 0;
                y: -44px;
                width: 180px;
                height: 40px;
                Rectangle {
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.smoke;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;
                    so := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Ui.sign-out();
                        }
                    }

                    Text {
                        x: 14px;
                        text: "Sign out";
                        color: so.has-hover ? Theme.amber : Theme.ivory;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ---- content --------------------------------------------------------------------------------

// The playing song's lyrics in the side panel. It glides to keep the sung line a third of the
// way down, unless the reader has scrolled away; following resumes 3 s after they stop.
component LyricsPanel inherits Rectangle {
    vertical-stretch: 1;
    property <bool> follow: true;
    property <length> sung-y: -1px;
    function scroll-to(y: length) {
        flick.content-y = min(0px, max(flick.height - flick.content-height, -(y - flick.height * 0.32)));
    }
    function reached(row-y: length) {
        root.sung-y = row-y;
        if root.follow {
            root.scroll-to(row-y);
        }
    }
    if Ui.lyrics.length == 0: EmptyState {
        icon: "lyrics";
        text: Ui.np.active ? Ui.lyrics-note : "Play something to see its lyrics.";
    }
    flick := Flickable {
        visible: Ui.lyrics.length > 0;
        content-height: col.preferred-height;
        animate content-y { duration: 600ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        flicked => {
            root.follow = false;
            resume.running = false;
            resume.running = true;
        }
        col := VerticalLayout {
            width: flick.width;
            padding-left: 14px;
            padding-right: 14px;
            // Room for the first lines to sit a third of the way down, and the last ones too.
            padding-top: 140px;
            padding-bottom: 320px;
            spacing: 8px;
            for l[i] in Ui.lyrics: LyricRow {
                line: l;
                index: i;
                active: Ui.lyric-line;
                seekable: true;
                init => {
                    if (self.sung && !self.line.background) || self.waiting {
                        root.reached(self.y);
                    }
                }
                changed sung => {
                    if self.sung && !self.line.background {
                        root.reached(self.y);
                    }
                }
                changed waiting => {
                    if self.waiting {
                        root.reached(self.y);
                    }
                }
            }
        }
    }

    resume := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.running = false;
            root.follow = true;
            if root.sung-y >= 0 {
                root.scroll-to(root.sung-y);
            }
        }
    }
}

component TopBar inherits Rectangle {
    height: 52px;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 16px;
        spacing: 4px;
        alignment: start;
        Rectangle {
            width: 32px;
            IconButton {
                icon: "back";
                tooltip: "Back";
                tooltip-below: true;
                enabled: Ui.can-back;
                clicked => {
                    Ui.back();
                }
            }
        }

        Rectangle {
            width: 32px;
            IconButton {
                icon: "forward";
                tooltip: "Forward";
                tooltip-below: true;
                enabled: Ui.can-forward;
                clicked => {
                    Ui.forward();
                }
            }
        }

        if Ui.offline: Rectangle {
            Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                height: 26px;
                width: offline-text.preferred-width + 24px;
                border-radius: 13px;
                background: #76291E80;
                offline-text := Text {
                    text: "You're offline · Retrying…";
                    color: Theme.ivory;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// ---- right panel ----------------------------------------------------------------------------

component QueueRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <length> row-height;
    in-out property <int> drop-target;
    height: row-height;
    border-radius: 6px;
    property <bool> hovered: ta.has-hover || close.hovered;
    background: root.track.current ? Theme.oxide.with-alpha(0.55) : root.hovered ? Theme.hover : transparent;
    opacity: ta.pressed && abs(ta.mouse-y - ta.pressed-y) > 4px ? 0.5 : 1;
    // Drop indicator above this root.track.
    if root.drop-target == root.index: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.amber;
    }
    accessible-role: list-item;
    accessible-label: root.track.title + ", " + root.track.artist;
    accessible-item-selected: root.track.current;
    accessible-action-default => {
        Ui.queue-jump(root.index);
    }
    queue-focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) {
                Ui.queue-jump(root.index);
                return accept;
            }
            if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                Ui.context("queue", root.index, "", { x: self.absolute-position.x + 20px, y: self.absolute-position.y + root.height });
                return accept;
            }
            reject
        }
    }

    if queue-focus.has-focus: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.amber;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        double-clicked => {
            Ui.queue-jump(root.index);
        }
        moved => {
            if (self.pressed && abs(self.mouse-y - self.pressed-y) > 4px) {
                // Rows below move it after them, rows above before them.
                root.drop-target = max(0, min(Ui.queue.length, root.index + round((self.mouse-y - self.pressed-y) / root.row-height) + (self.mouse-y > self.pressed-y ? 1 : 0)));
            }
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                Ui.context("queue", root.index, "", { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
            } else if (e.kind == PointerEventKind.up) {
                if (root.drop-target >= 0 && root.drop-target != root.index && root.drop-target != root.index + 1) {
                    // Dropping above row t moves the item to t (or t-1 when moving down).
                    Ui.queue-move(root.index, root.drop-target > root.index ? root.drop-target - 1 : root.drop-target);
                }
                root.drop-target = -1;
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;
        Rectangle {
            width: 36px;
            Art {
                width: 36px;
                height: 36px;
                source: root.track.art;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.track.title;
                color: root.track.current ? Theme.amber : Theme.ivory;
                font-size: 13px;
                font-weight: 550;
                overflow: elide;
            }

            Text {
                text: root.track.artist;
                color: Theme.beige;
                font-size: 12px;
                overflow: elide;
            }
        }

        // The duration, or on hover the remove button in its place.
        Rectangle {
            width: 36px;
            Text {
                width: 100%;
                visible: !root.hovered || root.track.current;
                text: root.track.duration;
                color: Theme.beige;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            close := IconButton {
                x: parent.width - 26px;
                visible: root.hovered && !root.track.current;
                icon: "close";
                tooltip: "Remove from queue";
                size: 26px;
                icon-size: 14px;
                clicked => {
                    Ui.queue-remove(root.index);
                }
            }
        }
    }
}

component RightPanel inherits Rectangle {
    property <int> drop-target: -1;
    background: Theme.panel;
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.smoke;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        // Segmented switch: Lyrics · Queue
        Rectangle {
            height: 30px;
            border-radius: 8px;
            background: Theme.smoke.with-alpha(0.6);
            HorizontalLayout {
                padding: 2px;
                for label[i] in ["Lyrics", "Queue"]: Rectangle {
                    border-radius: 6px;
                    background: Ui.panel-tab == i ? Theme.smoke : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Ui.panel-tab = i;
                            Ui.panel-changed();
                        }
                    }

                    Text {
                        text: label;
                        color: i == 0 && Ui.lyrics-missing ? Theme.dim
                            : Ui.panel-tab == i ? Theme.ivory : Theme.beige;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }
            }
        }

        if Ui.panel-tab == 0: LyricsPanel { }
        if Ui.panel-tab == 1 && (Ui.np.active || Ui.queue.length > 0): VerticalLayout {
            spacing: 8px;
            // "Up next", and a quiet action that swaps the rest for the playing song's radio.
            HorizontalLayout {
                height: 24px;
                padding-left: 4px;
                Text {
                    text: "Up next";
                    color: Theme.ivory;
                    font-size: 13px;
                    font-weight: 650;
                    vertical-alignment: center;
                }

                radio-btn := Rectangle {
                    width: radio-row.preferred-width;
                    border-radius: 6px;
                    background: radio-ta.has-hover ? #F1E5D214 : transparent;
                    radio-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 13px;
                            Icon {
                                name: "radio";
                                width: 13px;
                                height: 13px;
                                color: radio-ta.has-hover ? Theme.ivory : Theme.beige;
                            }
                        }
                        Text {
                            text: "Song radio";
                            color: radio-ta.has-hover ? Theme.ivory : Theme.beige;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    radio-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Ui.radio-from-current();
                        }
                    }
                }
            }

            if Ui.autoplay-chips.length > 0: Flickable {
                height: 30px;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                    spacing: 6px;
                    for label[i] in Ui.autoplay-chips: Rectangle {
                        width: chip-text.preferred-width + 24px;
                        height: 30px;
                        border-radius: 15px;
                        background: Ui.autoplay-picked == i ? Theme.ivory
                            : chip-ta.has-hover ? #F1E5D224 : #F1E5D214;
                        chip-text := Text {
                            text: label;
                            color: Ui.autoplay-picked == i ? Theme.carbon : Theme.ivory;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        chip-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Ui.autoplay-chip(i);
                            }
                        }
                    }
                }
            }
        }
        if Ui.panel-tab == 1 && Ui.queue.length == 0: EmptyState {
            vertical-stretch: 1;
            icon: "queue";
            text: "Nothing queued. Play an album or playlist, or use Add to queue on a song.";
        }
        if Ui.panel-tab == 1 && Ui.queue.length > 0: Rectangle {
            vertical-stretch: 1;
            queue-list := ListView {
                vertical-scrollbar-policy: always-off;
                for row[i] in Ui.queue: QueueRow {
                    track: row;
                    index: i;
                    row-height: 50px;
                    drop-target <=> root.drop-target;
                    init => {
                        Ui.row-shown(1, i);
                    }
                    changed index => {
                        Ui.row-shown(1, self.index);
                    }
                }
            }
            ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                content-y <=> queue-list.content-y;
                content-height: queue-list.content-height;
                visible-height: queue-list.visible-height;
            }
        }
    }
}

// ---- right-click menu ------------------------------------------------------------------------

// The app's own right-click menu, in the theme, drawn over everything.
component ContextMenu inherits Rectangle {
    width: 228px;
    height: items.preferred-height;
    border-radius: 10px;
    background: #1A1311F5;
    border-width: 1px;
    border-color: Theme.smoke;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #000000A0;
    items := VerticalLayout {
        padding: 5px;
        spacing: 1px;
        for e in Ui.menu-items: Rectangle {
            height: e.id == "-" ? 9px : 32px;
            if e.id == "-": Rectangle {
                y: 4px;
                height: 1px;
                background: Theme.smoke;
            }
            if e.id != "-": Rectangle {
                border-radius: 6px;
                background: item-ta.has-hover ? Theme.smoke : transparent;
                item-ta := TouchArea {
                    clicked => {
                        Ui.menu-open = false;
                        Ui.menu-chosen(e.id);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Rectangle {
                        width: 16px;
                        if e.icon != "": Icon {
                            name: e.icon;
                            width: 16px;
                            height: 16px;
                            color: e.danger ? #E8806A : Theme.amber;
                        }
                    }

                    Text {
                        text: e.label;
                        color: e.danger ? #E8806A : Theme.ivory;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// ---- equalizer ------------------------------------------------------------------------------

component EqBand inherits Rectangle {
    in property <float> gain; // dB, -12..12
    in property <string> label;
    callback changed(float);
    width: 30px;
    property <length> track: self.height - 24px;
    property <float> shown: ta.pressed ? max(-12, min(12, round((0.5 - ta.mouse-y / track) * 24 * 2) / 2)) : gain;
    Rectangle {
        y: 0;
        x: (parent.width - 4px) / 2;
        width: 4px;
        height: track;
        border-radius: 2px;
        background: Theme.smoke;
    }

    // Fill from the 0 dB line.
    Rectangle {
        x: (parent.width - 4px) / 2;
        width: 4px;
        y: shown >= 0 ? track / 2 - track * shown / 24 : track / 2;
        height: abs(track * shown / 24);
        background: Theme.amber;
    }

    Rectangle {
        x: (parent.width - 14px) / 2;
        y: track / 2 - track * shown / 24 - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.ivory;
        drop-shadow-blur: 6px;
        drop-shadow-color: #E9A15F80;
    }

    Text {
        y: track + 8px;
        text: root.label;
        color: Theme.beige;
        font-size: 10px;
        horizontal-alignment: center;
        width: 100%;
    }

    ta := TouchArea {
        height: track;
        y: 0;
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.changed(root.shown);
            }
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.changed(root.shown);
            }
        }
        double-clicked => {
            root.changed(0);
        }
    }
}

component EqPanel inherits Rectangle {
    width: 420px;
    height: 290px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.smoke;
    drop-shadow-blur: 30px;
    drop-shadow-color: #000000a0;
    TouchArea { } // keeps clicks inside from closing the panel

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Equalizer";
                color: Theme.ivory;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle { }

            // On/off switch
            Rectangle {
                width: 38px;
                height: 22px;
                y: 2px;
                border-radius: 11px;
                background: Ui.eq-enabled ? Theme.amber : Theme.smoke;
                Rectangle {
                    x: Ui.eq-enabled ? parent.width - 20px : 2px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Ui.eq-enabled ? Theme.carbon : Theme.beige;
                    animate x { duration: 150ms; }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Ui.eq-toggle();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            for p in ["Flat", "Bass", "Vocal", "Treble"]: Rectangle {
                height: 24px;
                border-radius: 12px;
                width: t.preferred-width + 20px;
                background: Ui.eq-preset == p ? Theme.oxide : pt.has-hover ? Theme.smoke : Theme.smoke.with-alpha(0.5);
                pt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Ui.eq-choose(p);
                    }
                }

                t := Text {
                    text: p;
                    color: Theme.ivory;
                    font-size: 12px;
                }
            }
            Rectangle { }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            opacity: Ui.eq-enabled ? 1 : 0.45;
            for label[i] in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"]: EqBand {
                label: label;
                gain: Ui.eq-gains[i];
                changed(g) => {
                    Ui.eq-set(i, g);
                }
            }
        }
    }
}

// ---- listen along ---------------------------------------------------------------------------

// A one-line text field for the Listen Along popover, with a placeholder.
component TogetherField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> mono;
    callback edited(string);
    callback accepted(string);
    public function take-focus() {
        input.focus();
    }
    height: 32px;
    border-radius: 8px;
    background: input.has-focus ? Theme.smoke : Theme.smoke.with-alpha(0.6);
    border-width: input.has-focus ? 1px : 0;
    border-color: Theme.amber.with-alpha(0.6);
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    if input.text == "": Text {
        x: 10px;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        color: Theme.ivory;
        selection-background-color: Theme.amber.with-alpha(0.45);
        font-size: 13px;
        font-family: root.mono ? "Consolas" : "";
        single-line: true;
        vertical-alignment: center;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }
}

// A small rounded button: secondary glass, or `danger` in the warning red the menus use.
component TogetherButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: label.preferred-width + 26px;
    border-radius: 14px;
    opacity: enabled ? 1 : 0.45;
    background: danger ? (ta.pressed ? #E8806A40 : ta.has-hover && enabled ? #E8806A30 : #E8806A1C)
        : (ta.pressed ? #F1E5D214 : ta.has-hover && enabled ? #F1E5D224 : #F1E5D21A);
    border-width: 1px;
    border-color: danger ? #E8806A33 : #F1E5D214;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    label := Text {
        text: root.text;
        color: root.danger ? #E8806A : Theme.ivory;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// Everyone in the session, one row each.
component TogetherMembers inherits VerticalLayout {
    spacing: 2px;
    for m[i] in Ui.together-members: Rectangle {
        height: 28px;
        border-radius: 6px;
        background: i == 0 ? #F1E5D20A : transparent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;
            Rectangle {
                width: 16px;
                Icon {
                    name: "user";
                    width: 16px;
                    height: 16px;
                    color: i == 0 ? Theme.amber : Theme.beige;
                }
            }

            Text {
                text: m;
                color: Theme.ivory;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

component TogetherHeading inherits Text {
    color: Theme.beige;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// The Listen Along popover over the now-playing bar: start or join a session, or see who's in it.
component TogetherPanel inherits Rectangle {
    width: 340px;
    height: lay.preferred-height;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.smoke;
    drop-shadow-blur: 30px;
    drop-shadow-color: #000000a0;
    init => {
        Ui.together-opened();
    }
    TouchArea { } // keeps clicks inside from closing the panel

    lay := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 18px;
                Icon {
                    name: "together";
                    width: 18px;
                    height: 18px;
                    color: Theme.amber;
                }
            }

            Text {
                text: Ui.together-state == 2 ? "You're hosting"
                    : Ui.together-state == 3 || Ui.together-state == 4 ? "Listening along with " + Ui.together-host : "Listen Along";
                color: Theme.ivory;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // Off: start a session, or join one.
        if Ui.together-state == 0: VerticalLayout {
            spacing: 12px;
            Text {
                text: "Listen together with friends, in perfect sync. Start a session and send them the invite code.";
                color: Theme.beige;
                font-size: 12px;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 6px;
                TogetherHeading {
                    text: "YOUR NAME";
                }

                TogetherField {
                    placeholder: "How friends see you";
                    text <=> Ui.together-name;
                    edited(t) => {
                        Ui.together-name-changed(t);
                    }
                }
            }

            HorizontalLayout {
                PillButton {
                    text: "Start a session";
                    icon: "together";
                    clicked => {
                        Ui.together-start();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.smoke;
            }

            TogetherHeading {
                text: "JOIN A SESSION";
            }

            // An invite code on the clipboard: one click joins.
            if Ui.together-found != "": Rectangle {
                height: 52px;
                border-radius: 10px;
                background: jf.pressed ? #E9A15F33 : jf.has-hover ? #E9A15F26 : #E9A15F1A;
                border-width: 1px;
                border-color: Theme.amber.with-alpha(0.5);
                jf := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Ui.together-join(Ui.together-found);
                    }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Join session";
                            color: Theme.amber;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Invite code " + Ui.together-found;
                            color: Theme.beige;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 16px;
                        Icon {
                            name: "chevron-right";
                            width: 16px;
                            height: 16px;
                            color: Theme.amber;
                        }
                    }
                }
            }

            if Ui.together-found == "": HorizontalLayout {
                spacing: 8px;
                code := TogetherField {
                    placeholder: "Paste an invite code";
                    mono: true;
                    accepted(t) => {
                        if (t != "") {
                            Ui.together-join(t);
                        }
                    }
                }

                TogetherButton {
                    y: 2px;
                    text: "Join";
                    enabled: code.text != "";
                    clicked => {
                        Ui.together-join(code.text);
                    }
                }
            }
        }

        // Connecting or starting.
        if Ui.together-state == 1: HorizontalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                for d in [0, 1, 2]: Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (28px - 6px) / 2;
                    border-radius: 3px;
                    background: Theme.amber;
                    opacity: 0.3 + 0.7 * abs(sin((animation-tick() / 1ms * 0.24 - d * 60) * 1deg));
                }
            }

            Text {
                text: "Connecting…";
                color: Theme.beige;
                font-size: 13px;
                vertical-alignment: center;
            }

            Rectangle { }

            TogetherButton {
                text: "Cancel";
                clicked => {
                    Ui.together-leave();
                }
            }
        }

        // Listening, but the link dropped: it rejoins by itself (the music plays on meanwhile).
        if Ui.together-state == 4: HorizontalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                for d in [0, 1, 2]: Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (28px - 6px) / 2;
                    border-radius: 3px;
                    background: Theme.amber;
                    opacity: 0.3 + 0.7 * abs(sin((animation-tick() / 1ms * 0.24 - d * 60) * 1deg));
                }
            }

            Text {
                text: "Reconnecting to " + Ui.together-host + "…";
                color: Theme.beige;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }

            Rectangle { }

            TogetherButton {
                text: "Leave";
                danger: true;
                clicked => {
                    Ui.together-leave();
                }
            }
        }

        // Hosting: the invite code, who's here, and ending it.
        if Ui.together-state == 2: VerticalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: #F1E5D20D;
                        border-width: 1px;
                        border-color: Theme.smoke;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: Ui.together-code;
                            color: Theme.ivory;
                            font-family: "Consolas";
                            font-size: 13px;
                            letter-spacing: 0.5px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    TogetherButton {
                        y: 2px;
                        text: "Copy";
                        clicked => {
                            Ui.together-copy();
                        }
                    }
                }

                Text {
                    text: "Friends paste this in Listen Along to join";
                    color: Theme.dim;
                    font-size: 11px;
                }
            }

            TogetherHeading {
                text: "IN THIS SESSION";
            }

            TogetherMembers { }

            HorizontalLayout {
                alignment: end;
                TogetherButton {
                    text: "End session";
                    danger: true;
                    clicked => {
                        Ui.together-leave();
                    }
                }
            }
        }

        // Listening: who's here, resync, and leaving.
        if Ui.together-state == 3: VerticalLayout {
            spacing: 12px;
            TogetherHeading {
                text: "IN THIS SESSION";
            }

            TogetherMembers { }

            HorizontalLayout {
                spacing: 8px;
                TogetherButton {
                    text: "Resync";
                    clicked => {
                        Ui.together-resync();
                    }
                }

                Text {
                    text: "If you hear a delay";
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Rectangle { }

                TogetherButton {
                    text: "Leave";
                    danger: true;
                    clicked => {
                        Ui.together-leave();
                    }
                }
            }
        }

        if Ui.together-status != "": Text {
            text: Ui.together-status;
            color: Theme.beige;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// ---- window ---------------------------------------------------------------------------------

// A short message over the bottom of the page, with maybe one action and a close button.
component ToastView inherits Rectangle {
    height: 44px;
    width: min(row.preferred-width + 24px, 560px);
    border-radius: 10px;
    background: #2A1E1AF2;
    border-width: 1px;
    border-color: #F1E5D21A;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000080;
    accessible-role: text;
    accessible-label: Ui.toast-text;
    hover := TouchArea {
        changed has-hover => {
            Ui.toast-hover(self.has-hover);
        }
    }
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 8px;
        alignment: start;
        Text {
            text: Ui.toast-text;
            color: Theme.ivory;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if Ui.toast-action != "": Rectangle {
            width: action.preferred-width + 16px;
            accessible-role: button;
            accessible-label: Ui.toast-action;
            accessible-action-default => {
                Ui.toast-act();
            }
            act-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Ui.toast-act();
                }
            }
            action := Text {
                text: Ui.toast-action;
                color: act-ta.has-hover ? Theme.ivory : Theme.amber;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: "close";
                size: 28px;
                icon-size: 14px;
                tooltip: "Dismiss";
                clicked => {
                    Ui.toast-dismiss();
                }
            }
        }
    }
}

// Your own title and artists for a song, over everything. Enter saves, Escape or a press
// outside leaves it as it was.
component EditSong inherits Rectangle {
    in-out property <bool> whole: Ui.edit-whole-channel;
    callback close();
    width: 380px;
    height: lay.preferred-height;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.smoke;
    drop-shadow-blur: 30px;
    drop-shadow-color: #000000a0;
    TouchArea { } // keeps clicks inside from closing it
    function save() {
        Ui.edit-save(title.text, artist.text, root.whole);
        root.close();
    }

    lay := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: "Edit song info";
            color: Theme.ivory;
            font-size: 15px;
            font-weight: 700;
        }

        TogetherHeading {
            text: "Title";
        }

        title := TogetherField {
            text: Ui.edit-title;
            placeholder: "Title";
            init => {
                self.take-focus();
            }
            accepted => {
                root.save();
            }
        }

        TogetherHeading {
            text: "Artist";
        }

        artist := TogetherField {
            text: Ui.edit-artist;
            placeholder: "Artist, Artist";
            accepted => {
                root.save();
            }
        }

        if Ui.edit-channel != "": Rectangle {
            height: 22px;
            accessible-role: checkbox;
            accessible-checkable: true;
            accessible-checked: root.whole;
            accessible-label: "Every song from " + Ui.edit-channel;
            accessible-action-default => {
                root.whole = !root.whole;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.whole = !root.whole;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.whole ? Theme.amber : transparent;
                    border-width: root.whole ? 0 : 1px;
                    border-color: Theme.beige.with-alpha(0.6);
                    if root.whole: Icon {
                        name: "check";
                        width: 12px;
                        height: 12px;
                        color: #120D0B;
                    }
                }

                Text {
                    text: "Every song from " + Ui.edit-channel;
                    color: Theme.ivory;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            padding-top: 6px;
            if Ui.edit-edited: TogetherButton {
                text: "Reset";
                clicked => {
                    Ui.edit-reset();
                    root.close();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }

            TogetherButton {
                text: "Cancel";
                clicked => {
                    root.close();
                }
            }

            PillButton {
                text: "Save";
                clicked => {
                    root.save();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Ember";
    icon: @image-url("../icons/ember-256.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.page;
    default-font-family: "Inter";
    // Built-in widgets (menus, scroll bars) follow the dark theme.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    property <length> sidebar-w: Ui.sidebar-collapsed ? 60px : 228px;
    property <length> panel-w: Ui.panel-open ? 340px : 0px;
    animate sidebar-w { duration: 200ms; easing: ease-out; }
    animate panel-w { duration: 250ms; easing: ease-out; }

    // A ceiling-light strip and a vignette. Static, so free per frame.
    Rectangle {
        y: 0;
        height: 1px;
        background: @linear-gradient(90deg, #E9A15F00 0%, #E9A15F55 50%, #E9A15F00 100%);
    }
    Rectangle {
        background: @radial-gradient(circle, #00000000 50%, #00000090 100%);
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "f" || e.text == "F")) {
                if (Ui.sidebar-collapsed) {
                    Ui.sidebar-collapsed = false;
                    Ui.sidebar-changed();
                }
                sidebar.focus-search();
                return accept;
            }
            // Ctrl+↑/↓ volume by 5 %, Ctrl+M mutes or brings the sound back.
            if (e.modifiers.control && (e.text == Key.UpArrow || e.text == Key.DownArrow)) {
                Ui.volume = clamp(Ui.volume + (e.text == Key.UpArrow ? 0.05 : -0.05), 0, 1);
                Ui.set-volume(Ui.volume);
                return accept;
            }
            if (e.modifiers.control && (e.text == "m" || e.text == "M")) {
                Ui.toggle-mute();
                return accept;
            }
            // Alt+←/→ back and forward, Ctrl+, Settings.
            if (e.modifiers.alt && e.text == Key.LeftArrow) {
                Ui.back();
                return accept;
            }
            if (e.modifiers.alt && e.text == Key.RightArrow) {
                Ui.forward();
                return accept;
            }
            if (e.modifiers.control && e.text == ",") {
                Ui.navigate(PageKind.settings, "", "Settings");
                return accept;
            }
            if (e.text == Key.Escape) {
                if (Ui.toast-text != "" && !Ui.menu-open) {
                    Ui.toast-dismiss();
                    return accept;
                }
                if (Ui.menu-open) {
                    Ui.menu-open = false;
                    return accept;
                }
                if (Ui.eq-open) {
                    Ui.eq-open = false;
                    return accept;
                }
                if (Ui.together-open) {
                    Ui.together-open = false;
                    keys.focus();
                    return accept;
                }
                if (Ui.panel-open) {
                    Ui.panel-open = false;
                    Ui.panel-changed();
                    return accept;
                }
            }
            if (e.text == " ") {
                Ui.play-pause();
                return accept;
            }
            // ←/→ seek 5 seconds (Shift: 15), Ctrl+←/→ change song.
            if (Ui.np.active && (e.text == Key.LeftArrow || e.text == Key.RightArrow)) {
                if (e.modifiers.control) {
                    if (e.text == Key.LeftArrow) {
                        Ui.previous();
                    } else {
                        Ui.next();
                    }
                    return accept;
                }
                if (Ui.np.duration-ms > 0) {
                    Ui.seek(clamp(Ui.np.position-ms + (e.text == Key.LeftArrow ? -1 : 1) * (e.modifiers.shift ? 15000 : 5000), 0, Ui.np.duration-ms - 1000));
                }
                return accept;
            }
            // Ctrl+L opens the lyrics, or closes them when they're showing.
            if (e.modifiers.control && (e.text == "l" || e.text == "L")) {
                if (Ui.panel-open && Ui.panel-tab == 0) {
                    Ui.panel-open = false;
                } else {
                    Ui.panel-open = true;
                    Ui.panel-tab = 0;
                }
                Ui.panel-changed();
                return accept;
            }
            reject
        }

        sidebar := Sidebar {
            searched => {
                keys.focus();
            }
            x: 0;
            y: 0;
            width: sidebar-w;
            height: parent.height - bar.height;
            collapsed: Ui.sidebar-collapsed;
        }

        Rectangle {
            x: sidebar-w;
            y: 0;
            width: parent.width - sidebar-w - panel-w;
            height: parent.height - bar.height;
            property <bool> settings: Ui.page.kind == PageKind.settings;
            property <bool> has-rows: Ui.page-count > 0 && !self.settings;
            if has-rows: PageView { }
            if settings: SettingsPage { }
            // Over the page, which scrolls under it.
            VerticalLayout {
                TopBar { }
                if !has-rows && !settings: StatusPage {
                    vertical-stretch: 1;
                }
                if has-rows || settings: Rectangle {
                    vertical-stretch: 1;
                }
            }
        }

        if panel-w > 0: RightPanel {
            x: parent.width - panel-w;
            y: 0;
            width: 340px;
            height: parent.height - bar.height;
        }

        bar := NowPlayingBar {
            y: parent.height - self.height;
        }

        if Ui.toast-text != "": ToastView {
            x: sidebar-w + (parent.width - sidebar-w - panel-w - self.width) / 2;
            y: parent.height - bar.height - self.height - 16px;
        }

        if Ui.eq-open: TouchArea {
            clicked => {
                Ui.eq-open = false;
            }
        }
        if Ui.eq-open: EqPanel {
            x: parent.width - self.width - 16px;
            y: parent.height - bar.height - self.height - 8px;
        }

        // Listen Along: a press outside closes it (and takes the keyboard back from its fields).
        if Ui.together-open: TouchArea {
            clicked => {
                Ui.together-open = false;
                keys.focus();
            }
        }
        if Ui.together-open: TogetherPanel {
            x: parent.width - self.width - 16px;
            y: parent.height - bar.height - self.height - 8px;
        }

        if Ui.editing: Rectangle {
            background: #00000080;
            TouchArea {
                clicked => {
                    Ui.editing = false;
                    keys.focus();
                }
            }

            FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        Ui.editing = false;
                        keys.focus();
                        return accept;
                    }
                    reject
                }
                EditSong {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    close => {
                        Ui.editing = false;
                        keys.focus();
                    }
                }
            }
        }

        // A press anywhere outside the menu closes it.
        if Ui.menu-open: TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    Ui.menu-open = false;
                }
            }
        }
        if Ui.menu-open: ContextMenu {
            x: max(4px, min(Ui.menu-at.x, parent.width - self.width - 8px));
            y: max(4px, min(Ui.menu-at.y, parent.height - self.height - 8px));
        }

        // Naming a new playlist: a press anywhere but the field puts it away. (A click elsewhere
        // doesn't take the keyboard from it, so the field can't tell by itself.)
        if Ui.naming-playlist: Rectangle {
            property <length> fx: Ui.naming-field.x;
            property <length> fy: Ui.naming-field.y;
            property <length> fw: Ui.naming-field.width;
            property <length> fh: Ui.naming-field.height;
            for r in [
                { x: 0px, y: 0px, w: parent.width, h: fy },
                { x: 0px, y: fy + fh, w: parent.width, h: parent.height - fy - fh },
                { x: 0px, y: fy, w: fx, h: fh },
                { x: fx + fw, y: fy, w: parent.width - fx - fw, h: fh },
            ]: TouchArea {
                x: r.x;
                y: r.y;
                width: max(0px, r.w);
                height: max(0px, r.h);
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        Ui.create-playlist("");
                    }
                }
            }
        }
    }
}
